{
  "name": "steam-pazar-panosu",
  "main": "src/worker.js",
  "observability": { "enabled": true },
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/data/*"]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "previews": {
    "ratelimits": [
      {
        "name": "RATE_LIMITER",
        "namespace_id": "2001",
        "simple": { "limit": 60, "period": 60 }
      }
    ]
  }
}
